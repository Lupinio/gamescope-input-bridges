#!/usr/bin/env python3
"""Tap-to-click for the built-in touchpad in the gamescope session.

gamescope never touches libinput's device configuration -- there is no
libinput_device_config_tap_* call in the binary at all -- so tapping stays off in
Gaming Mode no matter what KDE has configured, and only a real click of the
clickpad registers.  libinput offers no quirk to flip the default either.

So watch the touchpad and replay a short, motionless touch as a button press on a
virtual mouse.  The touchpad itself is left alone (no grab), it keeps driving the
cursor through libinput as before; we only add the clicks:

    1 finger -> left, 2 fingers -> right, 3 fingers -> middle

Started as part of gamescope-session.target only, so the desktop keeps using
KWin's own tap-to-click and nothing gets clicked twice.
"""

import sys
import time

import evdev
from evdev import InputDevice, UInput, ecodes as e

WAIT_SECONDS = 30
TAP_SECONDS = 0.30      # libinput uses 0.18, but measured lazy taps reach 270 ms
                        # and the drift check below is what really rejects moves
MOVE_MM = 2.5           # slide further than this and it is a move, not a tap
CLICK_HOLD = 0.06       # Steam's UI is CEF and samples per frame, so a 20 ms
                        # press can fall between two frames and be lost
BUTTON = {1: (e.BTN_LEFT, "left"), 2: (e.BTN_RIGHT, "right"),
          3: (e.BTN_MIDDLE, "middle")}


def find_touchpad():
    for path in evdev.list_devices():
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        caps = dev.capabilities()
        if (e.INPUT_PROP_POINTER in dev.input_props()
                and e.ABS_MT_SLOT in [c for c, _ in caps.get(e.EV_ABS, [])]):
            return dev
        dev.close()
    return None


def wait_for_touchpad():
    """The i2c pad is up at boot, but give it a moment after a resume."""
    deadline = time.monotonic() + WAIT_SECONDS
    while True:
        pad = find_touchpad()
        if pad is not None:
            return pad
        if time.monotonic() > deadline:
            sys.exit("no touchpad with ABS_MT_SLOT found")
        time.sleep(1)


def move_threshold(pad):
    """Device units that make up MOVE_MM, from the axis resolution."""
    for code, info in pad.capabilities().get(e.EV_ABS, []):
        if code == e.ABS_X and info.resolution:
            return MOVE_MM * info.resolution
    return 40.0  # ~2 mm on this pad if the kernel reports no resolution


def make_mouse():
    # REL_X/REL_Y are never written, but without them udev tags this as a plain
    # key device and libinput ignores the buttons.
    caps = {
        e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE],
        e.EV_REL: [e.REL_X, e.REL_Y],
    }
    return UInput(caps, name="GPD Touchpad Tap Clicks", vendor=0x093A,
                  product=0x0255, version=1)


def main():
    dry_run = "--dry-run" in sys.argv
    pad = wait_for_touchpad()
    limit = move_threshold(pad)
    ui = None if dry_run else make_mouse()
    print(f"tap-to-click on {pad.name} ({pad.path}), "
          f"move limit {limit:.0f} units{' [dry run]' if dry_run else ''}",
          flush=True)

    touching = False
    started = 0.0
    fingers = 0
    origin = None
    pos = {e.ABS_X: None, e.ABS_Y: None}
    drift = 0.0
    physical = False

    def click(button):
        if dry_run:
            return
        ui.write(e.EV_KEY, button, 1)
        ui.syn()
        time.sleep(CLICK_HOLD)
        ui.write(e.EV_KEY, button, 0)
        ui.syn()

    for event in pad.read_loop():
        if event.type == e.EV_ABS and event.code in pos:
            pos[event.code] = event.value

        elif event.type == e.EV_SYN and event.code == e.SYN_REPORT:
            # Only judge movement on a complete frame.  X and Y arrive as two
            # separate events, so measuring on every one of them compares a
            # fresh X against a stale Y and reads as a jump -- that alone ate
            # taps whenever the next one landed elsewhere on the pad.
            if touching and None not in pos.values():
                if origin is None:
                    origin = (pos[e.ABS_X], pos[e.ABS_Y])
                else:
                    drift = max(drift, abs(pos[e.ABS_X] - origin[0]),
                                abs(pos[e.ABS_Y] - origin[1]))

        elif event.type == e.EV_KEY:
            if event.code == e.BTN_TOUCH:
                if event.value:
                    touching = True
                    started = event.timestamp()
                    fingers = 1
                    origin = None
                    # Stale coordinates from the previous touch would otherwise
                    # become this touch's origin.
                    pos[e.ABS_X] = pos[e.ABS_Y] = None
                    drift = 0.0
                    physical = False
                elif touching:
                    touching = False
                    held = (event.timestamp() - started) * 1000
                    button = BUTTON.get(fingers)
                    if physical:
                        reason = "pad was really pressed"
                    elif drift > limit:
                        reason = f"moved {drift:.0f} > {limit:.0f} units"
                    elif held >= TAP_SECONDS * 1000:
                        reason = f"held too long ({held:.0f} ms)"
                    elif button is None:
                        reason = f"{fingers} fingers"
                    else:
                        reason = None
                    if reason is None:
                        code, label = button
                        print(f"tap: {fingers} finger(s), {held:.0f} ms, "
                              f"{drift:.0f} units -> {label}", flush=True)
                        click(code)
                    elif dry_run or (held < 500 and drift < limit * 4):
                        # Plain cursor moves are long and far; logging those
                        # would fill the journal during normal use.  Only the
                        # near misses are worth keeping.
                        print(f"no tap: {fingers} finger(s), {held:.0f} ms -- "
                              f"{reason}", flush=True)

            elif event.code in (e.BTN_TOOL_DOUBLETAP, e.BTN_TOOL_TRIPLETAP,
                                e.BTN_TOOL_QUADTAP) and event.value:
                fingers = max(fingers, {e.BTN_TOOL_DOUBLETAP: 2,
                                        e.BTN_TOOL_TRIPLETAP: 3,
                                        e.BTN_TOOL_QUADTAP: 4}[event.code])
                # The reported point jumps when a finger joins, so re-anchor.
                origin = None

            elif event.code in (e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE):
                # The pad was really pressed down; do not add a tap on top.
                physical = True


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
